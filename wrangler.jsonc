{
  // 阿綸涅亞 NIEIA：Cloudflare Worker 設定
  "name": "nieia",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // MongoDB 官方驅動程式需要 Node.js 相容模式
  "compatibility_flags": ["nodejs_compat"],
  // 讓需要連資料庫的程式自動在靠近 MongoDB（新加坡）的機房執行，減少連線往返時間
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./public",
    // 網頁檔案直接提供；/api/ 開頭的請求交給 Worker 處理
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "DB_NAME": "nieia"
  },
  // 預覽版（main 以外的分支）：用另一個資料庫名稱，測試時不會動到正式的預約與學員資料。
  // 預覽版的 MONGODB_URI、ADMIN_PASSWORD 需要另外用「wrangler preview secret」設定，沒設定時預覽版連不上資料庫，但不影響正式網站。
  "previews": {
    "vars": {
      "DB_NAME": "nieia_preview"
    },
    "placement": { "mode": "smart" }
  }
  // MONGODB_URI 是機密，不寫在這裡。
  // 請在 Cloudflare 後台的 Settings → Variables and Secrets 以 Secret 類型新增。
}
